# Copie para .env e ajuste:
#   cp .env.example .env
#
# No Portainer: cole as mesmas chaves em Stack -> Environment variables
# (nao suba o arquivo .env no Git).

# Usuario/grupo do host (Linux: id -u / id -g)
PUID=1000
PGID=1000

# Fuso horario
TZ=America/Sao_Paulo

# Caminhos no host (Portainer: use caminhos absolutos do Servidor Pessoal)
# CONFIG_ROOT: configs persistentes de cada app
# DATA_ROOT: torrents + biblioteca (mesmo filesystem = hardlinks)
CONFIG_ROOT=./config
DATA_ROOT=./data

# Portas publicadas no host
PORT_SONARR=8989
PORT_RADARR=7878
PORT_LIDARR=8686
PORT_READARR=8787
PORT_WHISPARR=6969
PORT_PROWLARR=9696
PORT_BAZARR=6767
PORT_FLARESOLVERR=8191
PORT_QBITTORRENT=8080
PORT_QBITTORRENT_TORRENTING=6881
PORT_PLEX=32400
PORT_SEERR=5055
PORT_WIZARR=5690
PORT_TAUTULLI=8181
PORT_PROFILARR=6868
PORT_TDARR_UI=8265
PORT_TDARR_SERVER=8266
PORT_MAINTAINERR=6246
PORT_HOMEPAGE=3000

# qBittorrent - porta interna do WebUI (deve bater com PORT_QBITTORRENT)
QBITTORRENT_WEBUI_PORT=8080
# Senha do WebUI (o script de configuração de fábrica cria categorias).
# Na 1a subida linuxserver gera senha no log.
QBITTORRENT_PASSWORD=

# Plex - obtenha em https://plex.tv/claim (vale por alguns minutos)
PLEX_CLAIM=
PLEX_ADVERTISE_IP=

# Homepage - hosts permitidos (obrigatorio na imagem atual)
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Kometa
KOMETA_TIMES=03:00
KOMETA_RUN=False

# API keys dos *Arr (Settings -> General). Preencha apos a 1a subida
# ou deixe o script ler dos config.xml em CONFIG_ROOT.
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
READARR_API_KEY=
WHISPARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=

# Configuração de fábrica (script no host)
# host = fala com localhost:PORT_* | docker = usa hostnames do compose (raro no host)
FABRICA_MODE=host
FABRICA_HOST=127.0.0.1
